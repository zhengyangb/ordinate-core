{
  "name": "ordinate-app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "desktop-out/desktop/main.js",
  "description": "Ordinate structured document editor",
  "scripts": {
    "app": "npm run desktop:build",
    "dev": "vite",
    "dev:online": "vite --mode online",
    "build": "tsc -b && vite build && node ../../scripts/generate-third-party-licenses.mjs web dist/licenses/THIRD_PARTY_LICENSES.txt",
    "build:online": "tsc -b && vite build --mode online && node ../../scripts/generate-third-party-licenses.mjs web dist/licenses/THIRD_PARTY_LICENSES.txt",
    "prepack": "node ../../scripts/prepare-package-license.mjs apps/ordinate-app",
    "preview": "vite preview",
    "preview:online": "vite preview --mode online",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "desktop:compile": "npm --prefix ../../packages/cli run build && tsc -p tsconfig.desktop.json && node desktop/build-native.mjs && node ../../scripts/generate-third-party-licenses.mjs desktop desktop-out/licenses/THIRD_PARTY_LICENSES.txt",
    "desktop:test-native": "npm run desktop:compile && node desktop/build-native.mjs --test && electron desktop/document-smoke.mjs",
    "desktop:test-workspace": "npm run build && npm run desktop:compile && electron desktop/workspace-smoke.mjs",
    "desktop:test-interchange": "npm run build && npm run desktop:compile && electron desktop/interchange-smoke.mjs",
    "desktop:test-print": "npm run build && npm run desktop:compile && electron desktop/interchange-smoke.mjs --print-only && node desktop/build-native.mjs --test && electron desktop/print-preview-smoke.mjs",
    "desktop:dev": "npm run desktop:compile && node desktop/dev.mjs",
    "desktop:debug": "npm run desktop:compile && node desktop/dev.mjs --inspect",
    "desktop:build": "npm run build && npm run desktop:compile && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "desktop:dmg:preview": "npm run build && npm run desktop:compile && swift desktop/render-dmg-background.swift resources/dmg-background.svg && electron-builder --mac dmg --config.electronDist=node_modules/electron/dist",
    "desktop:start": "electron ."
  },
  "build": {
    "appId": "dev.ordinate.desktop",
    "productName": "Ordinate",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "desktop-out/**/*",
      "!desktop-out/native/document-test.node",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/cli/dist/ordinate-cli.mjs",
        "to": "agent/ordinate-cli.mjs"
      },
      {
        "from": "../../packages/cli/skills/ordinate-authoring",
        "to": "agent/skills/ordinate-authoring"
      },
      {
        "from": "../../LICENSE",
        "to": "licenses/Ordinate-LICENSE.txt"
      },
      {
        "from": "desktop-out/licenses/THIRD_PARTY_LICENSES.txt",
        "to": "licenses/THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/Electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "icon": "resources/Ordinate.icon",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Ordinate Document",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "dev.ordinate.document"
            ],
            "NSDocumentClass": "OrdinateDocument"
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "dev.ordinate.document",
            "UTTypeDescription": "Ordinate Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ord"
              ]
            }
          }
        ]
      }
    },
    "dmg": {
      "background": "resources/dmg-background.png",
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 158,
          "y": 248,
          "type": "file"
        },
        {
          "x": 442,
          "y": 248,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "iconSize": 92,
      "iconTextSize": 12,
      "title": "Ordinate"
    },
    "asar": true,
    "asarUnpack": [
      "desktop-out/native/*.node"
    ]
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "node-api-headers": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^4.1.7"
  }
}
