{
  "name": "ordinate-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "desktop-out/desktop/main.js",
  "description": "Ordinate structured document editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "desktop:compile": "tsc -p tsconfig.desktop.json && node desktop/build-native.mjs",
    "desktop:test-native": "npm run desktop:compile && node desktop/build-native.mjs --test && electron desktop/document-smoke.mjs",
    "desktop:dev": "npm run desktop:compile && node desktop/dev.mjs",
    "desktop:debug": "npm run desktop:compile && node desktop/dev.mjs --inspect",
    "desktop:build": "npm run build && npm run desktop:compile && electron-builder --dir",
    "desktop:start": "electron ."
  },
  "build": {
    "appId": "dev.ordinate.desktop",
    "productName": "Ordinate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop-out/**/*",
      "!desktop-out/native/document-test.node",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Ordinate Document",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "dev.ordinate.document"
            ],
            "NSDocumentClass": "OrdinateDocument"
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "dev.ordinate.document",
            "UTTypeDescription": "Ordinate Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ord"
              ]
            }
          }
        ]
      }
    },
    "asar": true,
    "asarUnpack": [
      "desktop-out/native/*.node"
    ]
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "node-api-headers": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^4.1.7"
  }
}
