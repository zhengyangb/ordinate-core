| 2 | = F2 | = -pmt(@["Start Here"::["Loan annual rate","Value"]] / 12, @["Start Here"::["Loan years","Value"]] * 12, @["Start Here"::["Loan principal","Value"]]) | = -ipmt(@["Start Here"::["Loan annual rate","Value"]] / 12, A3, @["Start Here"::["Loan years","Value"]] * 12, @["Start Here"::["Loan principal","Value"]]) | = -ppmt(@["Start Here"::["Loan annual rate","Value"]] / 12, A3, @["Start Here"::["Loan years","Value"]] * 12, @["Start Here"::["Loan principal","Value"]]) | = B3 - E3 |
