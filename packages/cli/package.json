{
  "name": "ordinate-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "ordinate-cli": "dist/ordinate-cli.mjs" },
  "files": ["dist", "skills"],
  "scripts": {
    "build": "node build.mjs",
    "sync:skill": "npm run build && node skill_reference.mjs --write",
    "check:skill": "node skill_reference.mjs --check",
    "prepack": "npm run build && npm run check:skill",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": { "ordinate-core": "file:../core-ts" },
  "devDependencies": { "esbuild": "0.21.5", "typescript": "^5.6.0", "@types/node": "22.19.15" }
}
