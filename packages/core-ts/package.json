{
  "name": "ordinate-core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The Ordinate workbook parser, evaluator, and editing core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengyangb/ordinate-core.git",
    "directory": "packages/core-ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "type": "module",
  "scripts": {
    "prepack": "npm run build && node ../../scripts/prepare-package-license.mjs packages/core-ts",
    "test": "vitest run",
    "test:interchange": "vitest run --config vitest.interchange.config.ts",
    "test:excel": "vitest run --config vitest.excel.config.ts",
    "test:excel:recalc": "tsc -p tsconfig.excel-recalc.json && vitest run --config vitest.excel-recalc.config.ts",
    "test:watch": "vitest",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "0.21.5",
    "fast-formula-parser": "1.0.19",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0",
    "xlsx-calc": "^0.9.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "saxes": "^6.0.0"
  }
}
