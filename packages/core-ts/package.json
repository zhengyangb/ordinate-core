    "fast-formula-parser": "1.0.19",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0",
    "xlsx-calc": "^0.9.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "saxes": "^6.0.0"
  }
}
