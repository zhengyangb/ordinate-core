=== arithmetic_over_references
[doc]
# Calc
| Item || V |
| ---- || --- |
| A    || 4 |
| B    || 5 |
| C    || = @[A,_] + @[B,_] * 2 |
[/doc]
target_row: C
target_col: V
expect_kind: number
expect_value: 14

=== parentheses_over_references
[doc]
# Calc
| Item || V |
| ---- || --- |
| A    || 4 |
| B    || 5 |
| C    || = (@[A,_] + @[B,_]) * 2 |
[/doc]
target_row: C
target_col: V
expect_kind: number
expect_value: 18

=== equality_true
[doc]
# Calc
| Item || V |
| ---- || --- |
| A    || 3 |
| B    || 3 |
| C    || = @[A,_] == @[B,_] |
[/doc]
target_row: C
target_col: V
expect_kind: boolean
expect_value: true

