=== string_contains_equals_literal_roundtrip
[doc]
# Calc
| Item || V |
| ---- || --- |
| A    || "a=b" |
| B    || = @[A,_] |
[/doc]
target_row: B
target_col: V
expect_kind: string
expect_value: a=b
expect_validate_ok: true

