=== cell_metadata_spaces_canonicalized
[doc]
# Sheet
| Item || Val | Out |
| ---- || --- | --- |
| A    || 12.3 | = B2 {:,.2f : >, red } |
[/doc]
[expect]
# Sheet
| Item || Val | Out |
| ---- || --- | --- |
| A    || 12.3 | 12.3 = B2 {:,.2f:>,red} |
[/expect]
evaluate: true
target_row: A
target_col: Out
expect_source: cell
expect_align: right
expect_color: red
expect_bold: false
expect_format_type: f
expect_format_precision: 2
expect_format_grouping: true

=== column_inline_metadata_spaces_canonicalized
[doc]
# Sheet
| Item || Price {:,.1f : > } | Qty {:d : >} | Total |
| ---- || ----- | --- | ----- |
| A    || 1234.5 | 2 | = B2 * C2 |
[/doc]
[expect]
# Sheet
| Item || Price {:,.1f:>} | Qty {:d:>} | Total |
| ---- || ----- | --- | ----- |
| A    || 1234.5 | 2 | 2469 = B2 * C2 |
[/expect]
evaluate: true
target_row: A
target_col: Price
expect_source: column
expect_align: right
expect_color:
expect_bold: false
expect_format_type: f
expect_format_precision: 1
expect_format_grouping: true

