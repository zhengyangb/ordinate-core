=== cell_metadata_spaces_canonicalized
[doc]
# Sheet
| Item || Val | Out |
| ---- || --- | --- |
| A    || 12.3 | = B2 {:,.2f : >, red } |
[/doc]
[expect]
# Sheet
| Item || Val | Out |
| ---- || --- | --- |
| A    || 12.3 | 12.3 = B2 {:,.2f:>,red} |
[/expect]
evaluate: true
target_row: A
target_col: Out
expect_source: cell
expect_align: right
expect_color: red
expect_weight: null
expect_format_type: f
expect_format_precision: 2
expect_format_grouping: true

