| ---- || ----- | -------- | --- |
| A    || 2026-03-24T14:30:00Z {::blue} | PT1H30M {::bold} | 2026-03-24T14:30:00Z = B2 |
[/expect]
evaluate: true
target_row: A
target_col: Start
expect_source: cell
