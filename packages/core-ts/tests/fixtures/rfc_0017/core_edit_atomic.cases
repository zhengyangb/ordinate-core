set_cell_input_and_local_display_success
[doc]
# Sheet
| Item || 2024 | 2025 | Out |
| ---- || ---- | ---- | --- |
| A    || 1    | 2    | = B2 + C2 |
| B    || 3    | 4    | = B3 + C3 |
[/doc]
[ops]
[
  {
    "op": "set_cell_input",
    "target": { "kind": "label", "sheet": "Sheet", "rowPath": ["A"], "colLabel": "2024" },
    "input": "10"
  },
  {
    "op": "set_cell_local_format",
    "target": { "kind": "label", "sheet": "Sheet", "rowPath": ["A"], "colLabel": "Out" },
    "format": {
      "kind": "numeric",
      "sign": "default",
      "padWidth": null,
      "grouping": true,
      "precision": 2,
      "type": "f"
    }
  },
  {
    "op": "set_cell_local_style",
    "target": { "kind": "label", "sheet": "Sheet", "rowPath": ["A"], "colLabel": "Out" },
    "style": { "color": "green" }
  }
]
[/ops]
[expect]
# Sheet
| Item || 2024 | 2025 | Out |
| ---- || ---- | ---- | --- |
| A    || 10   | 2    | = B2 + C2 {:,.2f} {::green} |
| B    || 3    | 4    | = B3 + C3 |
[/expect]
expect_ok: true

