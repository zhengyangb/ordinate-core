===
atomic_failure_rolls_back_on_unresolved_target
[doc]
# Sheet
| Item || 2024 | 2025 | Out |
| ---- || ---- | ---- | --- |
| A    || 1    | 2    | = B2 + C2 |
| B    || 3    | 4    | = B3 + C3 |
[/doc]
[ops]
[
  {
    "op": "set_cell_input",
    "target": { "kind": "label", "sheet": "Sheet", "rowPath": ["A"], "colLabel": "2024" },
    "input": "10"
  },
  {
    "op": "set_cell_input",
    "target": { "kind": "label", "sheet": "Sheet", "rowPath": ["Missing"], "colLabel": "2024" },
    "input": "999"
  }
]
[/ops]
[expect]
# Sheet
| Item || 2024 | 2025 | Out |
| ---- || ---- | ---- | --- |
| A    || 1    | 2    | = B2 + C2 |
| B    || 3    | 4    | = B3 + C3 |
[/expect]
expect_ok: false
expect_error_category: invalid_target

