sum_excludes_header_rows
[doc]
# SumRows
| Item  || 2024 | 2025 | Sum |
| ----  || ---- | ---- | --- |
| A     || 1    | 2    |     |
| B     || 3    | 4    |     |
| Total ||      |      | = sum(@[:,#2]) |
[/doc]
target_row: Total
target_col: Sum
expect_kind: number
expect_value: 4

